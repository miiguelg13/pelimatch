# Copia este fichero como .env (no se sube a GitHub) y rellena los valores.

# MongoDB (en local, o la cadena de conexión de Atlas en producción)
MONGODB_URI=mongodb://127.0.0.1:27017/pelimatch

# TMDB → https://www.themoviedb.org/settings/api → «API Read Access Token» (empieza por eyJ…)
TMDB_TOKEN=

# Opcionales
# PORT=4300
# REGION=ES
# LANGUAGE=es-ES
# RSS_EVERY_MINUTES=60
