{
  "expo": {
    "name": "Pelimatch",
    "slug": "pelimatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.miguelgonza.pelimatch"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#121014"
        }
      ]
    ],
    "scheme": "pelimatch",
    "backgroundColor": "#121014",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://pelimatch.onrender.com",
      "router": {},
      "eas": {
        "projectId": "2d349fcd-efb9-4ebf-808c-61f374bc320d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2d349fcd-efb9-4ebf-808c-61f374bc320d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
